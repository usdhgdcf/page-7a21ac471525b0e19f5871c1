r(--line-soft)}\n  .faq-item h3 {margin: 0 0 8px;font-size: 16px;line-height: 1.5;font-weight: 700;letter-spacing: -0.005em}\n  .faq-item h3 .q {color: var(--lime-dim);margin-right: 8px;font-size: 13px;letter-spacing: 0.1em}\n  .faq-item p {margin: 0;font-size: 14px;color: #44473f}\n\n  /* 客户端 */\n  .clients {display: grid;grid-template-columns: repeat(2, 1fr);gap: 32px 44px}\n  .client h3 {margin: 0 0 8px;font-size: 18px;font-weight: 700;letter-spacing: -0.01em}\n  .client .platform {font-size: 11px;letter-spacing: 0.16em;text-transform: uppercase;color: var(--muted);margin-bottom: 8px;display: block}\n  .client p {margin: 0 0 8px;font-size: 14px;color: #3a3d38}\n  .client p:last-child {color: var(--muted);font-size: 13.5px;margin-bottom: 0}\n\n  .divider-note {margin-top: 44px;padding: 18px 0 0;border-top: 1px solid var(--line-soft);font-size: 13px;color: var(--muted);max-width: 68ch;line-height: 1.8}\n\n  footer {background: var(--ink);color: var(--muted-dark);padding: 40px 0 48px;font-size: 13px}\n  .foot-grid {display: flex;justify-content: space-between;gap: 24px;flex-wrap: wrap;align-items: flex-start}\n  .foot-brand {color: var(--paper);font-weight: 700;font-size: 16px;letter-spacing: 0.02em}\n  .foot-brand .dot {display: inline-block;width: 7px;height: 7px;background: var(--lime);margin-right: 8px;vertical-align: middle}\n  footer nav {display: flex;gap: 22px;flex-wrap: wrap}\n  footer a {text-decoration: none;border-bottom: 1px solid transparent}\n  footer a:hover, footer a:focus {color: var(--lime);border-bottom-color: var(--lime)}\n  .foot-line {margin-top: 24px;padding-top: 18px;border-top: 1px solid var(--line);font-size: 12px;color: #7c8177;line-height: 1.8;max-width: 70ch}\n\n  @media (max-width: 900px) {\n    .hero-head {grid-column: 1 / span 12}\n    .pullquote {grid-column: 1 / span 12}\n    .hero-notes {grid-column: 1 / span 12;grid-template-columns: 1fr}\n    .hero-meta {grid-template-columns: repeat(2, 1fr)}\n    .section-head {grid-template-columns: 1fr;align-items: start}\n    .section-head p {justify-self: start}\n    .flow {grid-template-columns: 1fr;gap: 30px}\n    .faq-grid {grid-template-columns: 1fr;gap: 0}\n    .clients {grid-template-columns: 1fr}\n    .topnav {font-size: 12px;gap: 14px}\n    section {padding: 52px 0}\n  }\n  @media (max-width: 520px) {\n    .wrap {padding: 0 18px}\n    .topbar .wrap {min-height: 48px}\n    .brandmark {font-size: 15px}\n    .topnav a:nth-child(n+4) {display: none}\n    .hero {padding: 40px 0 48px}\n    .hero-meta strong {font-size: 18px}\n  }\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"brandmark\"><span class=\"dot\"></span>HashCloud</div>\n    <nav class=\"topnav\" aria-label=\"页面导航\">\n      <a href=\"#use\">使用流程</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#scope\" class=\"tag\">说明范围</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-grid\">\n        <p class=\"hero-kicker\"><span>订阅说明</span><span class=\"rule\"></span><span>第 01 版</span></p>\n\n        <div class=\"hero-head\">\n          <h1 id=\"hero-title\">HashCloud<br><span class=\"accent\">把选择说清楚</span></h1>\n          <p class=\"hero-lead\">这一页只做一件事：把 HashCloud 的订阅方案、设备数量、流量额度与操作步骤按顺序写清楚，让你在决定之前看到全部条件，而不是在决定之后才发现条件。</p>\n        </div>\n\n        <blockquote class=\"pullquote\">\n          「先读条件，再看价格。顺序反了，价格会骗人。」\n          HashCloud 文档原则\n        </blockquote>\n\n        <div class=\"hero-notes\">\n          <div class=\"note\">\n            <h3>适用对象</h3>\n            <p>首次了解 HashCloud 订阅结构的个人用户与小型团队。已订阅用户在升级或调整设备数前，也可先核对此页。</p>\n          </div>\n          <div class=\"note\">\n            <h3>阅读方式</h3>\n            <p>按「使用流程 → 订阅方案 → 客户端 → 常见问题」顺序阅读。若只想比较价格，请直接跳转到订阅方案表格。</p>\n          </div>\n          <div class=\"note\">\n            <h3>信息边界</h3>\n            <p>本页仅陈述方案结构与操作顺序。具体线路质量、可用地区与实际速率取决于你所在网络环境，页面不作承诺。</p>\n          </div>\n        </div>\n\n        <div class=\"hero-meta\">\n          <div><strong>3</strong>方案档位</div>\n          <div><strong>100GB 起</strong>每月流量档位</div>\n          <div><strong>3–20 台</strong>同时在线设备</div>\n          <div><strong>年付</strong>计价周期之一</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"use\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <span class=\"eyebrow\">01 / 使用流程</span>\n          <h2 id=\"use-title\">从选择到日常使用，共四步</h2>\n        </div>\n        <p>以下顺序按实际操作发生的时间排列。每一步都标注了需要提前确认的信息，避免在中间环节返工。</p>\n      </div>\n\n      <div class=\"flow\">\n        <div class=\"step\">\n          <span class=\"num\">步骤 01</span>\n          <h3>确认设备数与月流量</h3>\n          <p>先数清会同时使用的设备数量，再估算一个月的流量大致上限。设备数与流量额度是方案划分的两个主要变量，先定这两项，档位基本就确定了。</p>\n          <p>如果两项需求落在两个不同档位之间，按较高的那一项选择，避免中途升级。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 02</span>\n          <h3>选定档位与计价周期</h3>\n          <p>在订阅方案表中横向比对三个档位。月付与年付对应不同的价格，年付按整年一次计价，适合需求稳定的使用者。</p>\n          <p>短期试用或需求可能变化时，优先选择月付，保留调整空间。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 03</span>\n          <h3>安装对应客户端</h3>\n          <p>依操作系统选择客户端，并完成安装。客户端版本以你实际获取到的发布信息为准，本页不提供下载地址。</p>\n          <p>安装完成后先确认客户端能够正常启动，再进行账户相关配置。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"num\">步骤 04</span>\n          <h3>核对额度与控制设备数</h3>\n          <p>使用过程中定期查看当月已用流量，并留意同时在线设备数是否超过所选档位的上限。</p>\n          <p>接近额度上限时，可选择等待新计费周期，或提前调整到更高档位。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <span class=\"eyebrow\">02 / 订阅方案</span>\n          <h2 id=\"plans-title\">三个档位，横向读完再决定</h2>\n        </div>\n        <p>表格按行列出可比较的条件。旗舰版以荧光绿标注，代表这是三档中的中间选型，不代表额外承诺。</p>\n      </div>\n\n      <div class=\"table-scroll\">\n        <table class=\"compare\">\n          HashCloud 订阅方案对照\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n              </th>\n              <th class=\"featured\">\n                <span class=\"plan-name\">旗舰版</span>\n                <span class=\"badge\">中间档</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15<small> / 月</small></span></td>\n              <td class=\"featured\"><span class=\"price\">¥35<small> / 月</small></span></td>\n              <td><span class=\"price\">¥85<small> / 月</small></span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年</td>\n              <td class=\"featured\">¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB</td>\n              <td class=\"featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体相关权益</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"featured\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>线路与节点</th>\n              <td>普通线路节点池</td>\n              <td class=\"featured\">IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>路由与定制</th>\n              <td>不包含</td>\n              <td class=\"featured\">不包含</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>常规工单支持</td>\n              <td class=\"featured\">7x24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合的情形</th>\n              <td>个人日常使用，设备少、流量需求有限</td>\n              <td class=\"featured\">多设备个人使用，对流媒体与游戏线路有要求</td>\n              <td>多人协作，需要更多设备数与更高流量额度</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"plans-note\">价格与权益以本表所列内容为说明口径。年付为一次性计价周期，不适合按短期需求选购。表格中「IPLC 专线游戏加速优化」「VIP 专属高带宽节点」等为方案权益名称，实际体验受本地网络条件影响；加速效果不构成速率或延迟承诺。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <span class=\"eyebrow\">03 / 客户端</span>\n          <h2 id=\"clients-title\">按操作系统选择客户端</h2>\n        </div>\n        <p>以下只说明客户端的适用环境与安装顺序。安装包来源与版本信息请以你实际获取到的发布渠道为准，本页不托管任何安装文件。</p>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <span class=\"platform\">桌面端 · Windows</span>\n          <h3>Windows 客户端</h3>\n          <p>适用于日常桌面使用。安装完成后首次启动，按界面提示完成账户关联，再核对可连接的设备数量是否与所选档位一致。</p>\n          <p>多设备场景下，建议固定一台主要设备用于查看当月流量使用情况。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"platform\">桌面端 · macOS</span>\n          <h3>macOS 客户端</h3>\n          <p>安装时按系统提示完成授权步骤。若首次启动被系统拦截，请在系统安全设置中按常规流程确认来源后再打开。</p>\n          <p>此说明不替代系统本身的权限规则，具体提示以系统界面为准。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"platform\">移动端 · iOS</span>\n          <h3>iOS 客户端</h3>\n          <p>通过系统应用渠道获取客户端。安装后完成账户配置，注意移动网络与无线网络切换时的连接状态。</p>\n          <p>移动端计入同时在线设备数，选购档位时请一并考虑手机是否长期在线。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"platform\">移动端 · Android</span>\n          <h3>Android 客户端</h3>\n          <p>安装包获取渠道以实际发布信息为准，本页不提供下载链接。安装前请确认设备允许来自所选渠道的应用安装。</p>\n          <p>完成后按与桌面端相同的顺序配置账户，并核对设备数占用情况。</p>\n        </div>\n      </div>\n\n      <p class=\"divider-note\" id=\"scope\">说明范围：本页包含方案结构、操作顺序、客户端类别与常见问题四类内容。涉及账户安全、支付方式、具体节点清单与可服务地区的信息，未在本页列出，也不在事实依据范围内，因此不作描述。若你需要这些细节，请以官方发布渠道的说明为准。</p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <span class=\"eyebrow\">04 / 常见问题</span>\n          <h2 id=\"faq-title\">常见问题与对应回答</h2>\n        </div>\n        <p>问题按选购与使用的常见顺序排列。左栏偏选购判断，右栏偏使用中的操作与限制。</p>\n      </div>\n\n      <div class=\"faq-grid\">\n        <div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q01</span>三个档位最核心的区别是什么？</h3>\n            <p>区别集中在两项可量化的条件：每月流量额度与同时在线设备数。基础版为 100GB 与 3 台，旗舰版为 300GB 与 5 台，团队版为 1000GB 与 20 台。其余权益随档位递增，用于区分线路与支持方式。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q02</span>该选月付还是年付？</h3>\n            <p>年付按整年一次性计价，适合需求稳定、且已经确认档位合适的使用者。若你仍在试用阶段，或使用频率可能明显变化，月付能保留调整空间，不必提前锁定一年。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q03</span>同时在线设备数怎么计算？</h3>\n            <p>按同一时间处于在线状态的设备数量计算，桌面端与移动端一并计入。若你经常手机与电脑同时在线，选购时请把这些设备算在内，而不是只算其中一台。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q04</span>流量额度是按自然月重置吗？</h3>\n            <p>方案以「每月流量」表述额度。本页仅能确认额度的数值，不包含具体重置日期的说明。计费周期的起算方式请以账户内的实际显示为准。</p>\n          </div>\n        </div>\n        <div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q05</span>超出当月流量会怎样？</h3>\n            <p>本页不描述超量后的具体处理方式，因为没有可依据的确认信息。可操作的做法是：在接近额度上限前，选择等待下一计费周期，或提前调整到更高流量的档位。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q06</span>旗舰版的线路与其他档位有何不同？</h3>\n            <p>表中列明旗舰版与团队版包含 IPLC 专线游戏加速优化，团队版另含 VIP 专属高带宽节点。这些是方案权益名称，实际效果受本地网络环境影响，不构成速率或延迟的量化承诺。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q07</span>团队版支持定制路由是什么意思？</h3>\n            <p>团队版在方案中列有「支持企业定制路由」这一项，区别于基础版与旗舰版。该权益的具体范围与实施方式本页不作展开，需要按你的实际网络结构单独确认。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q08</span>在哪里获取客户端安装包？</h3>\n            <p>本页不提供下载地址，也不托管安装文件。请以你实际获取到的官方发布渠道为准。安装前先确认渠道来源，再按操作系统选择对应版本。</p>\n          </div>\n          <div class=\"faq-item\">\n            <h3><span class=\"q\">Q09</span>适用地区有哪些？</h3>\n            <p>本页未列出可服务地区，因为不在已确认的信息范围内。选购前请先自行确认你所在地区与服务条款是否匹配，再决定档位与计价周期。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"foot-brand\"><span class=\"dot\"></span>HashCloud</div>\n        <div>订阅说明文档 · 第 01 版</div>\n      </div>\n      <nav aria-label=\"页脚导航\">\n        <a href=\"#use\">使用流程</a>\n        <a href=\"#plans\">订阅方案</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n        <a href=\"#scope\">说明范围</a>\n      </nav>\n    </div>\n    <p class=\"foot-line\">本页内容为方案结构与操作顺序的说明，不包含性能承诺、节点清单、可服务地区、账户安全与支付方式的描述。价格与权益以本页表格所列口径为准，实际体验取决于你所在网络环境。</p>\n  </div>\n</footer>",
